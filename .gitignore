# =============================================================================
# Kiro IDE
# =============================================================================
# Ignore Kiro IDE state, but track the specs (they are the source of truth for
# planned/implemented features). A parent dir can't be re-included once ignored,
# so ignore the contents (.kiro/*) and un-ignore .kiro/specs.
.kiro/*
!.kiro/specs/

# =============================================================================
# ESP32 Firmware — PlatformIO
# =============================================================================

# PlatformIO build output and dependency cache
firmware/.pio/
firmware/.cache/

# compile_commands.json (generated by PlatformIO for IDE tooling)
firmware/compile_commands.json

# =============================================================================
# Flutter Mobile App
# =============================================================================

# Dart tool cache
mobile/.dart_tool/

# Flutter build output
mobile/build/

# Flutter plugin dependencies file (auto-generated)
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies

# Flutter generated files
mobile/*.g.dart
mobile/**/*.g.dart

# =============================================================================
# Firebase
# =============================================================================

# Firebase local emulator data
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log

# =============================================================================
# OS / Editor
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code
.vscode/

# JetBrains IDEs
.idea/
*.iml

# =============================================================================
# Secrets — never commit these
# =============================================================================

# Firebase credentials and service account keys
google-services.json
GoogleService-Info.plist
*-service-account.json
*.keystore
*.jks

# Environment / secrets files
.env
.env.*
secrets.h
firmware/src/secrets.h

# =============================================================================
# Web app (React + Vite)
# =============================================================================
web/node_modules/
web/dist/
web/coverage/
web/.vite/

# =============================================================================
# Cloud Functions (TypeScript)
# =============================================================================
functions/node_modules/
functions/lib/
functions/coverage/

# =============================================================================
# Terraform
# =============================================================================
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!**/*.tfvars.example
.terraform.lock.hcl
