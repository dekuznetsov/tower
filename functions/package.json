{
  "name": "hydroponics-functions",
  "private": true,
  "version": "1.0.0",
  "description": "Cloud Functions for hydroponics monitoring alerts to Google Chat.",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "fast-check": "^3.22.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
